# Package the output of `npm run build` in this directory. This is useful on hosts where
# dependency installation during a container build has tighter memory/network limits.
FROM node:22-alpine AS runner
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
WORKDIR /app
ARG API_INTERNAL_URL=http://api:8000
ENV API_INTERNAL_URL=${API_INTERNAL_URL}
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static
COPY --chown=nextjs:nodejs public ./public
RUN node -e 'const fs=require("node:fs"); for(const file of [".next/required-server-files.json", ".next/routes-manifest.json"]) { const data=JSON.parse(fs.readFileSync(file,"utf8")); const update=(rules=[])=>rules.forEach(rule=>{ if(rule.source==="/api/:path*") rule.destination=process.env.API_INTERNAL_URL+"/api/:path*"; }); if(file.endsWith("required-server-files.json")) update(data.config._originalRewrites.afterFiles); else update(data.rewrites.afterFiles); fs.writeFileSync(file,JSON.stringify(data)); }'
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
